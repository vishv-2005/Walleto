# WhatsApp Message Extractor Configuration
# ──────────────────────────────────────────
# Get your credentials from: https://developers.facebook.com/
#   → Your App → WhatsApp → API Setup
#
# The ACCESS_TOKEN is temporary and expires every ~24 hours.
# Just replace it here and restart the server: node server.js

META_APP_SECRET=YOUR_APP_SECRET_HERE
META_VERIFY_TOKEN=walleto_verify_token
META_ACCESS_TOKEN=YOUR_TEMPORARY_ACCESS_TOKEN_HERE
META_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID_HERE
PORT=5000
NODE_ENV=development
